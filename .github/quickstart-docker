import { createClient } from 'your-library';

const client = createClient({
  apiKey: process.env.API_KEY,
  region: 'us-east-1'
});

const result = await client.process({
  input: 'Hello, world!',
  options: { verbose: true }
});

console.log(result.data);

// Full configuration options
const client = createClient({
  apiKey: process.env.API_KEY,
  region: 'us-east-1',
  retries: 3,
  timeout: 30000,
  logger: customLogger,
  hooks: {
    onRequest: (req) => console.log('Request:', req),
    onResponse: (res) => console.log('Response:', res)
  }
});

Variable	Type	Default	Description	
`API_KEY`	string	required	Your API authentication key	
`LOG_LEVEL`	string	`info`	Logging verbosity (`debug`, `info`, `warn`, `error`)	
`MAX_RETRIES`	number	`3`	Maximum retry attempts for failed requests	
`TIMEOUT`	number	`30000`	Request timeout in milliseconds	

API Reference
 createClient(config) 
Creates a new client instance.
Parameters:
 
 config  (Object): Configuration object
 
 apiKey  (string): Authentication key
 
 region  (string): Service region
Returns:  Client  instance
 client.process(options) 
Processes input data.
Parameters:
 
 options  (Object):
 
 input  (string): Data to process
 
 options.verbose  (boolean): Enable detailed logging
Returns:  Promise<Result> 
